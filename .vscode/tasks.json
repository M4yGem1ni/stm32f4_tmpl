{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build STM32 Firmware",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "${workspaceFolder}/build"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "CMake Configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-B", "${workspaceFolder}/build",
                "-DCMAKE_TOOLCHAIN_FILE=${workspaceFolder}/toolchain/arm-none-eabi-clang.cmake",
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
                "-G", "Ninja"
            ],
            "problemMatcher": []
        }
    ]
}
